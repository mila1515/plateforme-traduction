DEEPL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=
# Analyse facultative des ambiguïtés du texte source (gpt-5.4 par défaut).
OPENAI_AMBIGUITY_MODEL=
# DEBUG, INFO, WARNING ou ERROR. Le journal ne contient jamais le texte des documents.
LOG_LEVEL=INFO
# Identité de l'entreprise (voir docs/branding.md) ; vide = valeurs par défaut.
APP_NAME=
APP_LOGO=
APP_LOGO_DARK=
APP_LOGO_ICON=
